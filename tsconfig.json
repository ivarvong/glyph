    "outline/src/*.js",
    "render/src/*.js",
    "draw/src/*.js",
    "spec/src/*.js",
    "math/src/*.js",
    "worker/src/app.js",
    "cache/src/policy.js",
    "cache/src/key.js",
    "cache/src/layers.js",
