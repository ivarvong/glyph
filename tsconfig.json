{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "otel-compact/src/*.d.ts",
    "otel-compact/src/trace.js",
    "otel-compact/src/read.js",
